                      },
                      "expr": {
                        "text": "function pu(t0,a,d){ var x=time-t0; return (x>=0&&x<d)? a*Math.pow(1-x/d,2):0; }\nvar s = 100 + time*0.9 + pu(0.70,5,0.25) + pu(4.0,9,0.4);\n[s,s,s];",
