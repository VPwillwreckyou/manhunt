                        "t": "Vec3",
                        "v": [
                          1184.1333333333334,
                          617.0333333333333,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "seedRandom(168,true);\nvar t=Math.max(0,time-4.0);\nvar p0=[1184.1333333333334,617.0333333333333]; var dd=[p0[0]-964.8+random(-120,120), p0[1]-515.2+random(-90,90)]; var len=Math.max(60,Math.sqrt(dd[0]*dd[0]+dd[1]*dd[1])); var u=[dd[0]/len,dd[1]/len]; var sp=random(450,1100)+len*0.6; var zv=random(-1100,350);\nvar crack=linear(time,3.7,4.0,0,7); var jit=(time>3.7&&time<4.0)? (random(-1,1)*1.6*linear(time,3.7,4.0,0.2,1)) : 0;\nvar ramp=1-Math.exp(-16*t); var dist=sp*(1-Math.exp(-2.4*t))/2.4*ramp; var zz=zv*(1-Math.exp(-2*t))/2*ramp;\n[p0[0]+u[0]*(crack+dist)+jit, p0[1]+u[1]*(crack+dist)+120*t*t+jit, zz];",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
