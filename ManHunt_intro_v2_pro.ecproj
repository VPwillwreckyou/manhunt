                        "text": "seedRandom(400,true);\nvar t0=4.0,t=time-t0; var ang=random(0,6.2832), v=random(700,2600), life=random(0.4,1.1), g=1500;\nvar vx=Math.cos(ang)*v, vy=-Math.sin(ang)*v+g*Math.max(t,0); Math.atan2(vy,vx)*180/Math.PI;",
                        "enabled": true
                      },
                      "ui": {
