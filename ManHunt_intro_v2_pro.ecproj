                      "expr": {
                        "text": "function env(t0,amp,d){ var x=time-t0; return (x>=0&&x<d)? amp*Math.pow(1-x/d,2.5):0; }\nvar a = env(0.70,70,0.55)+env(1.62,18,0.45)+env(4.0,110,0.9)+((time>3.5&&time<4.0)?linear(time,3.5,4.0,1.5,9):0);\nwiggle(28, a);",
